# Public (bundled into the app) — see AGENTS.md
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_SANITY_PROJECT_ID=
EXPO_PUBLIC_SANITY_DATASET=
# Only needed for a published build: the origin serving /api routes.
EXPO_PUBLIC_API_URL=

# Server-side only — never prefix with EXPO_PUBLIC_
CLERK_SECRET_KEY=
# Sanity Context endpoint for server-side search, and an organization API token
# with Context Viewer access.
SANITY_CONTEXT_MCP_URL=
SANITY_ORGANIZATION_TOKEN=
# Knowledge Base endpoint for policy Q&A in Ask About This Stay
SANITY_KB_MCP_URL=
# OpenAI for structured decision outputs
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4o-mini
# Legacy Jev key, kept for reference
TYPESAFE_AI_API_KEY=
